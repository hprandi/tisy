# Used only by the integration test suite (test/jest-integration.json setupFiles) — separate
# database from dev, same local Postgres container.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ingressos_test?schema=public"

JWT_SECRET="e2e-test-secret-not-for-production"
JWT_EXPIRES_IN="7d"

# Fake Mercado Pago settings: the real provider reads them, but its HTTP API is faked in tests.
MERCADOPAGO_ACCESS_TOKEN="TEST-access-token-for-integration-tests"
MERCADOPAGO_WEBHOOK_SECRET="integration-test-webhook-secret"
